DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aeo?schema=public"
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
ENCRYPTION_KEY="replace-with-a-long-random-secret-at-least-32-chars"
APP_BASE_URL="http://localhost:3000"
REDIS_URL=""
QDRANT_URL=""
QDRANT_API_KEY=""
# Embeddings for the cognition vector space.
# PRIMARY path: enable a provider with `supportsEmbeddings` in the operator
# console (e.g. give the OpenAI provider a real key + enable it). No env needed.
# DeepSeek has no /embeddings endpoint, so it can't be that provider.
# OVERRIDE (optional): point at something not managed as a provider, e.g. local
# Ollama. When set, this wins over the DB provider.
#   Ollama:  EMBEDDING_API_URL="http://localhost:11434/v1"  EMBEDDING_MODEL="nomic-embed-text"  (no key)
EMBEDDING_API_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL=""
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_BUCKET=""
COGNITIVE_SERVICE_URL=""
COGNITIVE_SERVICE_API_KEY=""
PROBE_DEFAULT_MODE="standard"
PROBE_DEFAULT_EXECUTION_MODE="micro_batch"
PROBE_TARGET_THROUGHPUT_PER_MINUTE="500"
PROBE_MICRO_BATCH_SIZE="5"
PROBE_REQUESTS_PER_MINUTE="120"
PROBE_REQUESTS_PER_MINUTE_MIN="100"
PROBE_REQUESTS_PER_MINUTE_MAX="140"
PROBE_MAX_CONCURRENCY="24"
PROBE_MAX_CONCURRENCY_MIN="15"
PROBE_MAX_CONCURRENCY_MAX="30"
PROBE_TOKENS_PER_MINUTE_BUDGET="600000"
PROBE_TOKENS_PER_MINUTE_MIN="400000"
PROBE_TOKENS_PER_MINUTE_MAX="700000"
PROBE_MAX_RETRIES="3"
PROBE_SINGLE_MAX_OUTPUT_TOKENS="2000"
PROBE_BATCH_MAX_OUTPUT_TOKENS="8000"
PROBE_DEFAULT_MODEL="gpt-5"
PROBE_TEMPERATURE="0.3"
# Adaptive Semantic Neighborhood exploration. Full diagnosis enables this per
# run; this flag controls standalone Brand Probe runs.
SEMANTIC_EXPLORATION_ENABLED="false"
SEMANTIC_EXPLORATION_MAX_ITERATIONS="41"
SEMANTIC_EXPLORATION_MAX_ADDITIONAL_PROBES="640"
SEMANTIC_EXPLORATION_PROBES_PER_ITERATION="16"
SEMANTIC_EXPLORATION_MAX_DEPTH="2"
SEMANTIC_EXPLORATION_PROBE_DUPLICATE_THRESHOLD="0.90"
SEMANTIC_EXPLORATION_UNIT_DUPLICATE_THRESHOLD="0.92"
SEMANTIC_EXPLORATION_CLUSTER_THRESHOLD="0.85"
SEMANTIC_EXPLORATION_MAX_TOKENS="1000000"
SEMANTIC_EXPLORATION_MAX_COST="2"
SEMANTIC_EXPLORATION_MAX_DURATION_MS="14400000"
# Optional USD-per-million overrides. DeepSeek models use current conservative
# Flash cache-miss defaults; unknown models use a higher safety estimate.
# SEMANTIC_EXPLORATION_INPUT_COST_PER_MILLION="0.14"
# SEMANTIC_EXPLORATION_OUTPUT_COST_PER_MILLION="0.28"
CIP_LOG_LEVEL="info"
CIP_LOG_DB_ENABLED="true"
CIP_LOG_RETENTION_DAYS="90"
CIP_LOG_FILE_PATH=""
CIP_LOG_REDACT_KEYS=""

# Set to "true" only when the app sits behind a proxy that overwrites
# x-forwarded-for / x-real-ip. Left unset, those headers are ignored and the
# per-IP auth rate limit is skipped (the per-account limit still applies).
TRUSTED_PROXY=""
