# CIP production environment template.
# Copy to deploy/.env on the server and fill in real values:
#   cp .env.production.example deploy/.env
# deploy/.env is gitignored and must never be committed or baked into images.

# --- Database ---------------------------------------------------------------
# Values below are used by the postgres container itself (POSTGRES_*) and by
# the app. The app's DATABASE_URL must use "postgres" as host, which is the
# compose service name — not localhost.
POSTGRES_USER=aeo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aeo
DATABASE_URL=postgresql://aeo:replace-with-a-long-random-password@postgres:5432/aeo?schema=public

# --- Queue -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Secrets -----------------------------------------------------------------
# API keys stored in the operator console are encrypted with this key. It is
# required once any AI provider key is saved. Generate on the server with:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Ed25519 PKCS#8 PEM. Do not commit the real key. Generate and store it in the
# deployment secret manager; changing the ID starts a signing-key rotation.
REPORT_SIGNING_KEY_ID=cip-report-2026-01
REPORT_SIGNING_PRIVATE_KEY=replace-with-ed25519-private-key-pem
REPORT_SIGNING_PUBLIC_KEYS={}

# --- Private evidence snapshots --------------------------------------------
# Any private S3-compatible service is supported (for example Cloudflare R2,
# AWS S3, or a separately managed MinIO service). Sharing stays disabled until
# all four required values are configured.
S3_ENDPOINT=http://object-storage:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_BUCKET=cip-evidence

# --- App ---------------------------------------------------------------------
# Public URL customers reach the platform at.
APP_BASE_URL=https://your.domain.com
# The stack sits behind Caddy, which overwrites X-Forwarded-For, so per-IP
# auth rate limiting can trust those headers.
TRUSTED_PROXY=true
# On-site answer-readiness crawl for website audits (robots.txt obeyed,
# capped at 25 pages of the submitted origin).
WEBSITE_CRAWL_ENABLED=true
EVIDENCE_RAW_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
DELETED_PROJECT_PURGE_DAYS=30
BACKUP_RETENTION_DAYS=7

# Production seed passwords are intentionally not stored here. Supply
# SEED_OPERATOR_PASSWORD and SEED_CUSTOMER_PASSWORD only to the one-off seed
# command; production seeding refuses the development defaults.

# --- Notes -------------------------------------------------------------------
# AI provider API keys (OpenAI / Anthropic / Gemini / DeepSeek / ...) are NOT
# environment variables here. Enable providers and enter keys in the operator
# console (Admin -> AI Providers); they are stored encrypted in PostgreSQL.
#
# Optional integrations (Qdrant / Neo4j / S3 object storage / external
# cognitive service) stay disabled when their variables are absent; the
# operator console System Health page shows their status.
#
# The remaining PROBE_* / SEMANTIC_* / CIP_* variables have safe built-in
# defaults (see .env.example) and only need overriding for tuning.
