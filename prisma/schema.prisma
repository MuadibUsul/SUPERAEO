generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KeywordType {
  category
  scenario
  attribute
  intent
  competitor
  risk
}

enum QueryType {
  recommendation
  comparison
  alternative
  pricing
  use_case
  risk
  buyer_decision
  education
  best_tools
  implementation
}

enum RunType {
  baseline
  retest
}

enum RunStatus {
  draft
  queued
  running
  completed
  failed
  partially_failed
}

enum Platform {
  openai
  openai_compatible
  anthropic
  gemini
  perplexity
}

enum EntityType {
  brand
  competitor
  product
  source
  concept
}

enum SubjectEntityType {
  BRAND
  PERSON
  WEBSITE
  PRODUCT
}

enum MentionType {
  mentioned
  recommended
  cited
  compared
}

enum Sentiment {
  positive
  neutral
  negative
  mixed
  unknown
}

enum EdgeType {
  co_occurs
  semantically_close
  cited_by
  competes_with
  risk_association
}

enum GapType {
  semantic
  entity
  citation
  content
  technical
  authority
}

enum GapSeverity {
  low
  medium
  high
  critical
}

enum ActionType {
  content
  schema
  citation
  entity
  technical
  messaging
}

enum Priority {
  P1
  P2
  P3
}

enum ActionStatus {
  open
  in_progress
  done
  dismissed
}

enum PromptStatus {
  success
  repaired
  failed
}

enum ReportFormat {
  html
  pdf
}

enum ReportStatus {
  draft
  ready
  failed
}

enum UserRole {
  platform_owner
  operator_admin
  operator_viewer
  customer_owner
  customer_member
  customer_viewer
}

enum OrganizationType {
  internal
  customer
}

enum AIProviderType {
  openai_responses
  openai_compatible
  anthropic_messages
  gemini_native
  perplexity_sonar
}

enum AIUsageStatus {
  success
  failed
}

enum PromptTemplateStatus {
  active
  inactive
}

enum AlertType {
  hallucination
  cognitive_bias
  competitor_jump
  schema_missing
  citation_loss
  entity_confusion
}

enum AlertSeverity {
  P1
  P2
  P3
}

enum AlertStatus {
  open
  acknowledged
  resolved
  dismissed
}

enum AnalysisJobType {
  full_diagnosis
  brand_probe_run
  sampling_run
  response_analysis
  stability_analysis
  semantic_coverage
  graph_build
  report_generation
  semantic_nebula_build
  long_tail_opportunity_generation
  question_territory_build
  opportunity_probe_sampling
}

enum AnalysisJobStatus {
  queued
  running
  completed
  failed
  retrying
}

enum ObjectArtifactType {
  ai_response
  crawl_snapshot
  analysis_artifact
  report_export
}

enum PersonaType {
  founder
  ceo
  cto
  buyer
  marketer
  consumer
  analyst
}

enum ContextMode {
  cold_start
  industry_context
  competitive_context
  preference_guided
}

enum QueryDepthLevel {
  primary
  sub_question
  implicit
  decision
  risk
  comparison
  follow_up
}

enum RoutingTier {
  low_cost_sampling
  mid_tier_verification
  high_fidelity_audit
}

enum ExecutionStrategy {
  single_lane
  sharded_parallel
  adaptive_parallel
}

enum ProviderSelectionStrategy {
  primary_only
  round_robin
  priority_spread
}

enum BrandProbeRunMode {
  demo
  standard
  max500
}

enum BrandProbeExecutionMode {
  single
  micro_batch
}

enum BrandProbeStatus {
  pending
  queued
  running
  completed
  failed
  retrying
  skipped
}

enum BrandProbeZone {
  core_semantics
  implicit_recommendation
  competition
  scenario_fit
  audience_fit
  risk_boundary
  growth_opportunity
  calibration
}

enum BrandProbeQuestionType {
  explicit_association
  implicit_recommendation
  competitor_ranking
  scenario_fit
  audience_fit
  risk_boundary
  growth_opportunity
  calibration
}

enum SemanticTemperature {
  hot
  warm
  cold
}

enum ExtractedSignalType {
  keyword
  competitor
  scenario
  audience
  risk
  sentiment
  recommendation
  opportunity
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  passwordHash       String?              @map("password_hash")
  role               UserRole             @default(customer_owner)
  preferredLocale    String               @default("zh-CN") @map("preferred_locale")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  projects           Project[]
  sessions           Session[]
  memberships        OrganizationMember[]
  aiProvidersCreated AIProvider[]         @relation("AIProviderCreatedBy")
  aiUsageLogs        AIUsageLog[]
  promptTemplates    PromptTemplate[]     @relation("PromptTemplateCreatedBy")
  auditLogs          AuditLog[]           @relation("AuditActor")
  localePreferences  LocalePreference[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  type              OrganizationType     @default(customer)
  defaultLocale     String               @default("zh-CN") @map("default_locale")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  members           OrganizationMember[]
  projects          Project[]
  aiUsageLogs       AIUsageLog[]
  auditLogs         AuditLog[]
  localePreferences LocalePreference[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           UserRole     @default(customer_owner)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Project {
  id                           String                        @id @default(cuid())
  userId                       String                        @map("user_id")
  organizationId               String?                       @map("organization_id")
  name                         String
  brandName                    String                        @map("brand_name")
  domain                       String
  industry                     String
  targetMarket                 String                        @map("target_market")
  language                     String                        @default("en")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization                 Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  competitors                  Competitor[]
  keywords                     SemanticKeyword[]
  queries                      AeoQuery[]
  runs                         SamplingRun[]
  edges                        SemanticEdge[]
  gaps                         InclusionGap[]
  actionItems                  ActionItem[]
  reports                      Report[]
  promptRuns                   PromptRun[]
  metrics                      MetricSnapshot[]
  usageLogs                    AIUsageLog[]
  alerts                       Alert[]
  entityProfiles               EntityProfile[]
  citationSources              CitationSource[]
  querySamples                 QuerySample[]
  stabilitySnapshots           StabilitySnapshot[]
  confidenceIntervals          ConfidenceInterval[]
  semanticCoverageSnapshots    SemanticCoverageSnapshot[]
  websiteCrawlSnapshots        WebsiteCrawlSnapshot[]
  analysisJobs                 AnalysisJob[]
  objectArtifacts              ObjectArtifact[]
  subjects                     ProjectSubject[]
  semanticNebulaSnapshots      SemanticNebulaSnapshot[]
  longTailOpportunitySnapshots LongTailOpportunitySnapshot[]
  questionTerritorySnapshots   QuestionTerritorySnapshot[]
  brandProbeRuns               BrandProbeRun[]
  brandProbes                  BrandProbe[]
  brandProbeBatches            BrandProbeBatch[]
  brandProbeResponses          BrandProbeResponse[]
  extractedSignals             ExtractedSignal[]
  externalMetricSources        ExternalMetricSource[]
  externalMetricPoints         ExternalMetricPoint[]
  cognitionExperiments         CognitionExperiment[]

  @@index([userId])
  @@index([organizationId])
  @@map("projects")
}

model ProjectSubject {
  id                           String                        @id @default(cuid())
  projectId                    String                        @map("project_id")
  entityType                   SubjectEntityType             @map("entity_type")
  displayName                  String                        @map("display_name")
  canonicalName                String                        @map("canonical_name")
  websiteUrl                   String?                       @map("website_url") @db.Text
  market                       String?
  language                     String                        @default("en")
  profileJson                  Json?                         @map("profile_json")
  isPrimary                    Boolean                       @default(true) @map("is_primary")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywords                     SemanticKeyword[]
  queries                      AeoQuery[]
  runs                         SamplingRun[]
  promptRuns                   PromptRun[]
  metrics                      MetricSnapshot[]
  probeResults                 ProbeResult[]
  semanticNebulaSnapshots      SemanticNebulaSnapshot[]
  longTailOpportunitySnapshots LongTailOpportunitySnapshot[]
  questionTerritorySnapshots   QuestionTerritorySnapshot[]
  brandProbeRuns               BrandProbeRun[]
  brandProbes                  BrandProbe[]
  brandProbeResponses          BrandProbeResponse[]
  extractedSignals             ExtractedSignal[]
  cognitionExperiments         CognitionExperiment[]

  @@unique([projectId, canonicalName, entityType])
  @@index([projectId, isPrimary])
  @@index([entityType])
  @@map("project_subjects")
}

model Competitor {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  domain    String?
  category  String   @default("direct")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("competitors")
}

model SemanticKeyword {
  id           String          @id @default(cuid())
  projectId    String          @map("project_id")
  subjectId    String?         @map("subject_id")
  keyword      String
  keywordType  KeywordType     @map("keyword_type")
  targetWeight Float           @map("target_weight")
  reason       String?
  confidence   Float?
  createdAt    DateTime        @default(now()) @map("created_at")
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject      ProjectSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  queries      AeoQuery[]

  @@unique([projectId, keyword])
  @@index([projectId, keywordType])
  @@index([subjectId, keywordType])
  @@map("semantic_keywords")
}

model AeoQuery {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  subjectId           String?              @map("subject_id")
  queryText           String               @map("query_text") @db.Text
  queryType           QueryType            @map("query_type")
  persona             String?
  personaType         PersonaType?         @map("persona_type")
  region              String?              @default("US")
  contextMode         ContextMode          @default(cold_start) @map("context_mode")
  queryDepthLevel     QueryDepthLevel      @default(primary) @map("query_depth_level")
  intent              String?
  targetKeywordId     String?              @map("target_keyword_id")
  confidence          Float?
  createdAt           DateTime             @default(now()) @map("created_at")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject             ProjectSubject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  targetKeyword       SemanticKeyword?     @relation(fields: [targetKeywordId], references: [id], onDelete: SetNull)
  responses           AIResponse[]
  samples             QuerySample[]
  probeResults        ProbeResult[]
  experimentQuestions ExperimentQuestion[]

  @@index([projectId, queryType])
  @@index([subjectId, queryType])
  @@index([projectId, region])
  @@index([projectId, personaType])
  @@index([targetKeywordId])
  @@map("queries")
}

model SamplingRun {
  id                           String                        @id @default(cuid())
  projectId                    String                        @map("project_id")
  subjectId                    String?                       @map("subject_id")
  runType                      RunType                       @map("run_type")
  status                       RunStatus                     @default(draft)
  platforms                    String[]                      @default([])
  sampleCount                  Int                           @default(0) @map("sample_count")
  sampleCountPerQuery          Int                           @default(1) @map("sample_count_per_query")
  selectedQueryIds             String[]                      @default([]) @map("selected_query_ids")
  samplingStrategy             Json?                         @map("sampling_strategy")
  scheduledAt                  DateTime?                     @map("scheduled_at")
  queueJobId                   String?                       @map("queue_job_id")
  traceId                      String?                       @map("trace_id")
  failureSummary               String?                       @map("failure_summary") @db.Text
  startedAt                    DateTime?                     @map("started_at")
  completedAt                  DateTime?                     @map("completed_at")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject                      ProjectSubject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  responses                    AIResponse[]
  metrics                      MetricSnapshot[]
  reports                      Report[]
  samples                      QuerySample[]
  stabilitySnapshots           StabilitySnapshot[]
  confidenceIntervals          ConfidenceInterval[]
  analysisJobs                 AnalysisJob[]
  probeResults                 ProbeResult[]
  semanticNebulaSnapshots      SemanticNebulaSnapshot[]
  longTailOpportunitySnapshots LongTailOpportunitySnapshot[]
  questionTerritorySnapshots   QuestionTerritorySnapshot[]
  experimentWaves              ExperimentWave[]

  @@index([projectId, runType, status])
  @@index([subjectId, runType, status])
  @@index([queueJobId])
  @@map("sampling_runs")
}

model AIResponse {
  id               String           @id @default(cuid())
  runId            String           @map("run_id")
  queryId          String           @map("query_id")
  providerId       String?          @map("provider_id")
  modelId          String?          @map("model_id")
  platform         Platform
  model            String
  sampleIndex      Int              @default(0) @map("sample_index")
  region           String?
  persona          String?
  objectKey        String?          @map("object_key")
  rawResponse      String           @map("raw_response") @db.Text
  normalizedAnswer String?          @map("normalized_answer") @db.Text
  citations        Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  run              SamplingRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  query            AeoQuery         @relation(fields: [queryId], references: [id], onDelete: Cascade)
  provider         AIProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  aiModel          AIModel?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  analysis         AnswerAnalysis?
  probeResults     ProbeResult[]
  mentions         EntityMention[]
  citationSources  CitationSource[]
  samples          QuerySample[]
  alerts           Alert[]

  @@index([runId])
  @@index([queryId])
  @@index([providerId])
  @@index([modelId])
  @@index([runId, queryId, sampleIndex])
  @@map("ai_responses")
}

model AnswerAnalysis {
  id                     String     @id @default(cuid())
  responseId             String     @unique @map("response_id")
  brandMentioned         Boolean    @default(false) @map("brand_mentioned")
  brandRecommended       Boolean    @default(false) @map("brand_recommended")
  brandPosition          Int?       @map("brand_position")
  brandDescription       String?    @map("brand_description") @db.Text
  competitorsMentioned   Json?      @map("competitors_mentioned")
  recommendationWinner   String?    @map("recommendation_winner")
  mentionContext         String?    @map("mention_context") @db.Text
  sentiment              Sentiment  @default(unknown)
  matchedKeywords        Json?      @map("matched_keywords")
  citationsUsed          Json?      @map("citations_used")
  possibleHallucinations Json?      @map("possible_hallucinations")
  confidence             Float      @default(0)
  rawAnalysis            Json?      @map("raw_analysis")
  createdAt              DateTime   @default(now()) @map("created_at")
  response               AIResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("answer_analyses")
}

model EntityMention {
  id          String      @id @default(cuid())
  responseId  String      @map("response_id")
  entityName  String      @map("entity_name")
  entityType  EntityType  @map("entity_type")
  mentionType MentionType @map("mention_type")
  position    Int?
  sentiment   Sentiment   @default(unknown)
  confidence  Float       @default(0)
  context     String?     @db.Text
  response    AIResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([entityName])
  @@map("entity_mentions")
}

model SemanticEdge {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  sourceNode String   @map("source_node")
  sourceType String   @map("source_type")
  targetNode String   @map("target_node")
  targetType String   @map("target_type")
  edgeType   EdgeType @map("edge_type")
  weight     Float
  confidence Float
  evidence   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, edgeType])
  @@map("semantic_edges")
}

model InclusionGap {
  id                  String       @id @default(cuid())
  projectId           String       @map("project_id")
  gapType             GapType      @map("gap_type")
  severity            GapSeverity
  targetKeyword       String?      @map("target_keyword")
  reason              String       @db.Text
  evidence            Json?
  competitorAdvantage String?      @map("competitor_advantage") @db.Text
  suggestedAction     String?      @map("suggested_action") @db.Text
  confidence          Float        @default(0)
  createdAt           DateTime     @default(now()) @map("created_at")
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionItems         ActionItem[]

  @@index([projectId, gapType, severity])
  @@map("inclusion_gaps")
}

model ActionItem {
  id                  String        @id @default(cuid())
  projectId           String        @map("project_id")
  gapId               String?       @map("gap_id")
  actionType          ActionType    @map("action_type")
  priority            Priority
  targetKeyword       String?       @map("target_keyword")
  title               String
  description         String        @db.Text
  whyThisMatters      String?       @map("why_this_matters") @db.Text
  recommendedAsset    String?       @map("recommended_asset")
  implementationNotes String?       @map("implementation_notes") @db.Text
  expectedImpact      String?       @map("expected_impact") @db.Text
  retestQueries       Json?         @map("retest_queries")
  successMetric       String?       @map("success_metric")
  evidence            Json?
  status              ActionStatus  @default(open)
  createdAt           DateTime      @default(now()) @map("created_at")
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gap                 InclusionGap? @relation(fields: [gapId], references: [id], onDelete: SetNull)

  @@index([projectId, priority, status])
  @@map("action_items")
}

model Report {
  id        String       @id @default(cuid())
  projectId String       @map("project_id")
  runId     String?      @map("run_id")
  title     String
  format    ReportFormat @default(html)
  status    ReportStatus @default(draft)
  snapshot  Json?
  html      String?      @db.Text
  fileUrl   String?      @map("file_url")
  createdAt DateTime     @default(now()) @map("created_at")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run       SamplingRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, runId])
  @@map("reports")
}

model SemanticNebulaSnapshot {
  id           String         @id @default(cuid())
  projectId    String         @map("project_id")
  subjectId    String         @map("subject_id")
  runId        String?        @map("run_id")
  scope        String
  version      String         @default("2026-05-19.v1")
  nodeJson     Json           @map("node_json")
  edgeJson     Json           @map("edge_json")
  summaryJson  Json?          @map("summary_json")
  evidenceJson Json?          @map("evidence_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject      ProjectSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  run          SamplingRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, subjectId, scope, createdAt])
  @@index([runId])
  @@map("semantic_nebula_snapshots")
}

model LongTailOpportunitySnapshot {
  id              String         @id @default(cuid())
  projectId       String         @map("project_id")
  subjectId       String         @map("subject_id")
  runId           String?        @map("run_id")
  version         String         @default("2026-05-19.v1")
  opportunityJson Json           @map("opportunity_json")
  summaryJson     Json?          @map("summary_json")
  createdAt       DateTime       @default(now()) @map("created_at")
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject         ProjectSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  run             SamplingRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, subjectId, createdAt])
  @@index([runId])
  @@map("long_tail_opportunity_snapshots")
}

model QuestionTerritorySnapshot {
  id            String         @id @default(cuid())
  projectId     String         @map("project_id")
  subjectId     String         @map("subject_id")
  runId         String?        @map("run_id")
  version       String         @default("2026-05-19.v1")
  territoryJson Json           @map("territory_json")
  summaryJson   Json?          @map("summary_json")
  createdAt     DateTime       @default(now()) @map("created_at")
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject       ProjectSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  run           SamplingRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, subjectId, createdAt])
  @@index([runId])
  @@map("question_territory_snapshots")
}

model PromptRun {
  id              String          @id @default(cuid())
  projectId       String?         @map("project_id")
  subjectId       String?         @map("subject_id")
  providerId      String?         @map("provider_id")
  promptName      String          @map("prompt_name")
  promptVersion   String          @map("prompt_version")
  model           String
  input           Json
  rawOutput       String?         @map("raw_output") @db.Text
  parsedOutput    Json?           @map("parsed_output")
  status          PromptStatus
  error           String?         @db.Text
  repairAttempted Boolean         @default(false) @map("repair_attempted")
  usage           Json?
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject         ProjectSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  provider        AIProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([projectId, promptName])
  @@index([subjectId, promptName])
  @@index([providerId])
  @@map("prompt_runs")
}

model MetricSnapshot {
  id                       String          @id @default(cuid())
  projectId                String          @map("project_id")
  subjectId                String?         @map("subject_id")
  runId                    String          @map("run_id")
  sampleCount              Int             @map("sample_count")
  aiAnswerInclusionScore   Float           @map("ai_answer_inclusion_score")
  aiVisibilityScore        Float?          @map("ai_visibility_score")
  mentionRate              Float           @map("mention_rate")
  recommendationShare      Float           @map("recommendation_share")
  citationRate             Float           @map("citation_rate")
  aiImpressionShare        Float?          @map("ai_impression_share")
  entityVisibility         Float?          @map("entity_visibility")
  semanticCoverage         Float?          @map("semantic_coverage")
  semanticUniverseStrength Float           @map("semantic_universe_strength")
  stabilityScore           Float           @map("stability_score")
  stabilityIndex           Float?          @map("stability_index")
