  traceId     String            @map("trace_id")
  status      AnalysisJobStatus @default(queued)
  payload     Json
  result      Json?
  error       String?           @db.Text
  attempts    Int               @default(0)
  startedAt   DateTime?         @map("started_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         SamplingRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([queueName, queueJobId])
  @@index([traceId])
  @@map("analysis_jobs")
}

model ObjectArtifact {
  id           String             @id @default(cuid())
  projectId    String?            @map("project_id")
  artifactType ObjectArtifactType @map("artifact_type")
  bucket       String?
  objectKey    String             @map("object_key")
  contentType  String?            @map("content_type")
  byteSize     Int?               @map("byte_size")
  checksum     String?
  metadata     Json?
  createdAt    DateTime           @default(now()) @map("created_at")
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, artifactType])
  @@map("object_artifacts")
}

model ProviderRoutingRule {
  id         String      @id @default(cuid())
  task       String
  tier       RoutingTier
  providerId String      @map("provider_id")
  modelId    String?     @map("model_id")
  enabled    Boolean     @default(true)
  priority   Int         @default(100)
  maxCostUsd Float?      @map("max_cost_usd")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  provider   AIProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model      AIModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([task, enabled, priority])
  @@map("provider_routing_rules")
}

model TaskExecutionPolicy {
  id                   String                    @id @default(cuid())
  task                 String                    @unique
  tier                 RoutingTier               @default(mid_tier_verification)
  enabled              Boolean                   @default(true)
  executionStrategy    ExecutionStrategy         @default(single_lane) @map("execution_strategy")
  providerSelection    ProviderSelectionStrategy @default(primary_only) @map("provider_selection")
  laneCount            Int                       @default(1) @map("lane_count")
  minLaneCount         Int                       @default(1) @map("min_lane_count")
  maxLaneCount         Int                       @default(4) @map("max_lane_count")
  targetLatencySeconds Int                       @default(120) @map("target_latency_seconds")
  timeoutSeconds       Int                       @default(90) @map("timeout_seconds")
  metadata             Json?
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@index([enabled, task])
  @@map("task_execution_policies")
}

// ============================================================================
// Proof layer: connect AI-visibility to real outcomes, and prove that an
// intervention (not model drift) caused a change via a treatment/control design.
// ============================================================================

enum ExternalSourceType {
  ga4
  csv_upload
  webhook
  manual
}

enum ExperimentStatus {
  draft
  running
  measuring
  concluded
  archived
}

enum ExperimentArm {
  treatment
  control
}

enum ExperimentWaveType {
  baseline
  retest
}

/// A connected source of real business outcomes (AI-referral sessions, leads,
/// signups, revenue) used to correlate against AI-visibility over time.
model ExternalMetricSource {
  id           String                @id @default(cuid())
  projectId    String                @map("project_id")
  sourceType   ExternalSourceType    @map("source_type")
  name         String
  config       Json?
  status       String                @default("connected")
  lastSyncedAt DateTime?             @map("last_synced_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points       ExternalMetricPoint[]

  @@index([projectId, sourceType])
  @@map("external_metric_sources")
}

/// A single daily outcome value (e.g. ai_referral_sessions on a date).
model ExternalMetricPoint {
  id        String               @id @default(cuid())
  projectId String               @map("project_id")
  sourceId  String               @map("source_id")
  metricKey String               @map("metric_key")
  date      DateTime             @db.Date
  value     Float
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    ExternalMetricSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, metricKey, date])
  @@index([projectId, metricKey, date])
  @@map("external_metric_points")
}

/// A controlled experiment: a set of question clusters split into a treatment
/// arm (content interventions applied) and a control arm (left untouched), so
/// model drift can be netted out via difference-in-differences.
model CognitionExperiment {
  id          String               @id @default(cuid())
  projectId   String               @map("project_id")
  subjectId   String?              @map("subject_id")
  name        String
  hypothesis  String?              @db.Text
  metricKey   String               @default("mention_rate") @map("metric_key")
  status      ExperimentStatus     @default(draft)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject     ProjectSubject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignments ExperimentQuestion[]
  waves       ExperimentWave[]
  results     ExperimentResult[]

  @@index([projectId, status])
  @@map("cognition_experiments")
}

/// Assigns a query to the treatment or control arm of an experiment.
model ExperimentQuestion {
  id           String              @id @default(cuid())
  experimentId String              @map("experiment_id")
  queryId      String              @map("query_id")
  arm          ExperimentArm
  createdAt    DateTime            @default(now()) @map("created_at")
  experiment   CognitionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  query        AeoQuery            @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([experimentId, queryId])
  @@index([experimentId, arm])
  @@map("experiment_questions")
}

/// A measurement wave (baseline before the intervention, retest after).
model ExperimentWave {
  id           String                  @id @default(cuid())
  experimentId String                  @map("experiment_id")
  waveType     ExperimentWaveType      @map("wave_type")
  label        String?
  runId        String?                 @map("run_id")
  measuredAt   DateTime                @default(now()) @map("measured_at")
  experiment   CognitionExperiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  run          SamplingRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  observations ExperimentObservation[]

  @@index([experimentId, waveType])
  @@map("experiment_waves")
}

/// Aggregated success/sample counts for one arm in one wave.
model ExperimentObservation {
  id        String         @id @default(cuid())
  waveId    String         @map("wave_id")
  arm       ExperimentArm
  samples   Int
  successes Int
  createdAt DateTime       @default(now()) @map("created_at")
  wave      ExperimentWave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@unique([waveId, arm])
  @@map("experiment_observations")
}

/// The computed difference-in-differences result: net lift with model drift
/// (the control delta) removed, plus a significance test.
model ExperimentResult {
  id                String              @id @default(cuid())
  experimentId      String              @map("experiment_id")
  metricKey         String              @map("metric_key")
  treatmentPreRate  Float               @map("treatment_pre_rate")
  treatmentPostRate Float               @map("treatment_post_rate")
  controlPreRate    Float               @map("control_pre_rate")
  controlPostRate   Float               @map("control_post_rate")
  treatmentDelta    Float               @map("treatment_delta")
  controlDelta      Float               @map("control_delta")
  netLift           Float               @map("net_lift")
  zScore            Float               @map("z_score")
  pValue            Float               @map("p_value")
  significant       Boolean
  computedAt        DateTime            @default(now()) @map("computed_at")
  experiment        CognitionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, computedAt])
  @@map("experiment_results")
}
